# Append this complete template at EOF of a global-only base sshd_config.
# Reconcile existing Match blocks separately; never use an early Include.
# Validate the full candidate and independent operator access before reload.
PermitUserEnvironment no
Match User vtc-deploy
  AuthenticationMethods publickey
  PasswordAuthentication no
  KbdInteractiveAuthentication no
  AllowTcpForwarding no
  AllowAgentForwarding no
  X11Forwarding no
  PermitTTY no
  PermitTunnel no
