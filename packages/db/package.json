{
  "name": "@vtc/db",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "exports": {
    "./admissions-schema": {
      "types": "./dist/schema/admissions/index.d.ts",
      "default": "./dist/schema/admissions/index.js"
    },
    "./qualifications-schema": {
      "types": "./dist/schema/qualifications/index.d.ts",
      "default": "./dist/schema/qualifications/index.js"
    },
    "./platform-schema": {
      "types": "./dist/schema/platform.d.ts",
      "default": "./dist/schema/platform.js"
    },
    "./identity-schema": {
      "types": "./dist/schema/identity/index.d.ts",
      "default": "./dist/schema/identity/index.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./messaging-schema": {
      "types": "./dist/schema/messaging.d.ts",
      "default": "./dist/schema/messaging.js"
    }
  },
  "files": [
    "dist",
    "migrations/**/*.sql",
    "migrations/meta/_journal.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "generate": "drizzle-kit generate --config drizzle.config.ts",
    "migrate": "node --env-file-if-exists=../../.env dist/migrate-cli.js"
  },
  "dependencies": {
    "@types/node": "24.19.2",
    "mysql2": "3.24.6",
    "drizzle-orm": "0.45.4"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.11"
  }
}
