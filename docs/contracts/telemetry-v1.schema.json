{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/vtc-dashboard/contracts/telemetry-v1.schema.json",
  "title": "VTC-003 telemetry ingestion request v1.0",
  "description": "Structural request schema only. Authorization, UTF-8 byte/depth/decimal ranges, identity conflicts, source truth and durable acknowledgement require contract semantic/integration checks.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "producer",
    "eventId",
    "revision",
    "installationId",
    "bindingId",
    "source",
    "delivery",
    "type",
    "createdUtcMs",
    "snapshot"
  ],
  "properties": {
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "major",
        "minor"
      ],
      "properties": {
        "major": {
          "const": 1
        },
        "minor": {
          "const": 0
        }
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "application",
        "version"
      ],
      "properties": {
        "application": {
          "const": "ets2telemetry"
        },
        "version": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[^\\u0000-\\u001f\\u007f]*$",
          "minLength": 1
        }
      }
    },
    "eventId": {
      "$ref": "#/$defs/uuid"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "installationId": {
      "$ref": "#/$defs/uuid"
    },
    "bindingId": {
      "$ref": "#/$defs/uuid"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "game",
        "tripId",
        "pluginSessionId",
        "databaseUuid",
        "origin"
      ],
      "properties": {
        "provider": {
          "const": "ets2telemetry"
        },
        "game": {
          "enum": [
            "ets2",
            "ats"
          ]
        },
        "tripId": {
          "$ref": "#/$defs/uuid"
        },
        "pluginSessionId": {
          "$ref": "#/$defs/uuid"
        },
        "databaseUuid": {
          "$ref": "#/$defs/uuid"
        },
        "origin": {
          "const": "game"
        }
      }
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "syncRunId"
      ],
      "properties": {
        "mode": {
          "enum": [
            "live",
            "backfill"
          ]
        },
        "syncRunId": {
          "$ref": "#/$defs/uuid"
        }
      }
    },
    "type": {
      "enum": [
        "trip.started",
        "trip.completed",
        "trip.cancelled",
        "trip.closed",
        "trip.corrected"
      ]
    },
    "createdUtcMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "snapshot": {
      "$ref": "#/$defs/snapshot"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "trip.started"
          }
        }
      },
      "then": {
        "properties": {
          "snapshot": {
            "properties": {
              "outcome": {
                "enum": [
                  "open"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "trip.completed"
          }
        }
      },
      "then": {
        "properties": {
          "snapshot": {
            "properties": {
              "outcome": {
                "enum": [
                  "delivered"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "trip.cancelled"
          }
        }
      },
      "then": {
        "properties": {
          "snapshot": {
            "properties": {
              "outcome": {
                "enum": [
                  "cancelled"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "trip.closed"
          }
        }
      },
      "then": {
        "properties": {
          "snapshot": {
            "properties": {
              "outcome": {
                "enum": [
                  "none"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "trip.corrected"
          }
        }
      },
      "then": {
        "properties": {
          "snapshot": {
            "properties": {
              "outcome": {
                "enum": [
                  "delivered",
                  "cancelled",
                  "none"
                ]
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "sequence": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,19}$",
      "description": "Positive canonical decimal source sequence; semantic validator also enforces uint64 range."
    },
    "version": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "major",
        "minor"
      ],
      "properties": {
        "major": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "minor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        }
      }
    },
    "availableId": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "available",
            "value"
          ],
          "properties": {
            "available": {
              "const": true
            },
            "value": {
              "type": "string",
              "maxLength": 128,
              "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "available",
            "reason"
          ],
          "properties": {
            "available": {
              "const": false
            },
            "reason": {
              "enum": [
                "not-observed",
                "not-supported",
                "invalid"
              ]
            }
          }
        }
      ]
    },
    "availableLabel": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "available",
            "value"
          ],
          "properties": {
            "available": {
              "const": true
            },
            "value": {
              "type": "string",
              "maxLength": 256,
              "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "available",
            "reason"
          ],
          "properties": {
            "available": {
              "const": false
            },
            "reason": {
              "enum": [
                "not-observed",
                "not-supported",
                "invalid"
              ]
            }
          }
        }
      ]
    },
    "availableBoolean": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "available",
            "value"
          ],
          "properties": {
            "available": {
              "const": true
            },
            "value": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "available",
            "reason"
          ],
          "properties": {
            "available": {
              "const": false
            },
            "reason": {
              "enum": [
                "not-observed",
                "not-supported",
                "invalid"
              ]
            }
          }
        }
      ]
    },
    "availableCount": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "available",
            "value"
          ],
          "properties": {
            "available": {
              "const": true
            },
            "value": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "available",
            "reason"
          ],
          "properties": {
            "available": {
              "const": false
            },
            "reason": {
              "enum": [
                "not-observed",
                "not-supported",
                "invalid"
              ]
            }
          }
        }
      ]
    },
    "availableVersion": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "available",
            "value"
          ],
          "properties": {
            "available": {
              "const": true
            },
            "value": {
              "$ref": "#/$defs/version"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "available",
            "reason"
          ],
          "properties": {
            "available": {
              "const": false
            },
            "reason": {
              "enum": [
                "not-observed",
                "not-supported",
                "invalid"
              ]
            }
          }
        }
      ]
    },
    "distance": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "available",
            "value",
            "unit"
          ],
          "properties": {
            "available": {
              "const": true
            },
            "value": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000000000
            },
            "unit": {
              "const": "m"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "available",
            "reason",
            "unit"
          ],
          "properties": {
            "available": {
              "const": false
            },
            "reason": {
              "enum": [
                "not-observed",
                "not-supported",
                "invalid"
              ]
            },
            "unit": {
              "const": "m"
            }
          }
        }
      ]
    },
    "mass": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "available",
            "value",
            "unit"
          ],
          "properties": {
            "available": {
              "const": true
            },
            "value": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000000
            },
            "unit": {
              "const": "kg"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "available",
            "reason",
            "unit"
          ],
          "properties": {
            "available": {
              "const": false
            },
            "reason": {
              "enum": [
                "not-observed",
                "not-supported",
                "invalid"
              ]
            },
            "unit": {
              "const": "kg"
            }
          }
        }
      ]
    },
    "fuel": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "available",
            "value",
            "unit"
          ],
          "properties": {
            "available": {
              "const": true
            },
            "value": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000000
            },
            "unit": {
              "const": "L"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "available",
            "reason",
            "unit"
          ],
          "properties": {
            "available": {
              "const": false
            },
            "reason": {
              "enum": [
                "not-observed",
                "not-supported",
                "invalid"
              ]
            },
            "unit": {
              "const": "L"
            }
          }
        }
      ]
    },
    "damage": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "available",
            "value",
            "unit"
          ],
          "properties": {
            "available": {
              "const": true
            },
            "value": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000
            },
            "unit": {
              "const": "fraction"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "available",
            "reason",
            "unit"
          ],
          "properties": {
            "available": {
              "const": false
            },
            "reason": {
              "enum": [
                "not-observed",
                "not-supported",
                "invalid"
              ]
            },
            "unit": {
              "const": "fraction"
            }
          }
        }
      ]
    },
    "time": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "utcMs",
        "basis",
        "eventSeq"
      ],
      "properties": {
        "utcMs": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "basis": {
          "enum": [
            "event",
            "checkpoint",
            "last-known",
            "receipt",
            "unknown"
          ]
        },
        "eventSeq": {
          "anyOf": [
            {
              "$ref": "#/$defs/sequence"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "basis": {
                "const": "event"
              }
            }
          },
          "then": {
            "properties": {
              "utcMs": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "eventSeq": {
                "$ref": "#/$defs/sequence"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "basis": {
                "const": "unknown"
              }
            }
          },
          "then": {
            "properties": {
              "utcMs": {
                "type": "null"
              },
              "eventSeq": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "place": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cityId",
        "cityName",
        "companyId",
        "companyName"
      ],
      "properties": {
        "cityId": {
          "$ref": "#/$defs/availableId"
        },
        "cityName": {
          "$ref": "#/$defs/availableLabel"
        },
        "companyId": {
          "$ref": "#/$defs/availableId"
        },
        "companyName": {
          "$ref": "#/$defs/availableLabel"
        }
      }
    },
    "trailer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "id",
        "bodyType",
        "chainType"
      ],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9
        },
        "id": {
          "$ref": "#/$defs/availableId"
        },
        "bodyType": {
          "$ref": "#/$defs/availableId"
        },
        "chainType": {
          "$ref": "#/$defs/availableId"
        }
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome",
        "closeReason",
        "recordingCompleteness",
        "start",
        "end",
        "openedBy",
        "openedEventSeq",
        "checkpointNextEventSeq",
        "outcomeEventSeq",
        "context",
        "gameMode",
        "job",
        "trailers",
        "plannedDistance",
        "observedDistance",
        "deliveredDistance",
        "fuelUsed",
        "cargoDamage",
        "expectedIncome",
        "revenue",
        "penalty",
        "evidence"
      ],
      "properties": {
        "outcome": {
          "enum": [
            "open",
            "delivered",
            "cancelled",
            "none"
          ]
        },
        "closeReason": {
          "anyOf": [
            {
              "enum": [
                "outcome",
                "configuration-cleared",
                "different-job",
                "restart",
                "discontinuity",
                "gap"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "recordingCompleteness": {
          "enum": [
            "complete",
            "partial",
            "unknown"
          ]
        },
        "start": {
          "$ref": "#/$defs/time"
        },
        "end": {
          "anyOf": [
            {
              "$ref": "#/$defs/time"
            },
            {
              "type": "null"
            }
          ]
        },
        "openedBy": {
          "enum": [
            "event",
            "checkpoint"
          ]
        },
        "openedEventSeq": {
          "anyOf": [
            {
              "$ref": "#/$defs/sequence"
            },
            {
              "type": "null"
            }
          ]
        },
        "checkpointNextEventSeq": {
          "anyOf": [
            {
              "$ref": "#/$defs/sequence"
            },
            {
              "type": "null"
            }
          ]
        },
        "outcomeEventSeq": {
          "anyOf": [
            {
              "$ref": "#/$defs/sequence"
            },
            {
              "type": "null"
            }
          ]
        },
        "context": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "gameBuild",
            "sourceLocale",
            "mapId",
            "dlcIds",
            "versions"
          ],
          "properties": {
            "gameBuild": {
              "$ref": "#/$defs/availableId"
            },
            "sourceLocale": {
              "$ref": "#/$defs/availableId"
            },
            "mapId": {
              "$ref": "#/$defs/availableId"
            },
            "dlcIds": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "available",
                    "value"
                  ],
                  "properties": {
                    "available": {
                      "const": true
                    },
                    "value": {
                      "type": "array",
                      "maxItems": 256,
                      "uniqueItems": true,
                      "items": {
                        "type": "string",
                        "maxLength": 128,
                        "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
                      }
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "available",
                    "reason"
                  ],
                  "properties": {
                    "available": {
                      "const": false
                    },
                    "reason": {
                      "enum": [
                        "not-observed",
                        "not-supported",
                        "invalid"
                      ]
                    }
                  }
                }
              ]
            },
            "versions": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "nativeProtocol",
                "sdkArchive",
                "telemetryApi",
                "gameTelemetryApi"
              ],
              "properties": {
                "nativeProtocol": {
                  "$ref": "#/$defs/version"
                },
                "sdkArchive": {
                  "$ref": "#/$defs/availableId"
                },
                "telemetryApi": {
                  "$ref": "#/$defs/availableVersion"
                },
                "gameTelemetryApi": {
                  "$ref": "#/$defs/availableVersion"
                }
              }
            }
          }
        },
        "gameMode": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "method",
            "confidence",
            "ambiguous"
          ],
          "properties": {
            "mode": {
              "enum": [
                "single-player",
                "truckersmp",
                "unknown"
              ]
            },
            "method": {
              "enum": [
                "module-scan",
                "process-scan",
                "none"
              ]
            },
            "confidence": {
              "enum": [
                "strong",
                "weak",
                "none"
              ]
            },
            "ambiguous": {
              "type": "boolean"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "mode": {
                    "const": "unknown"
                  }
                }
              },
              "then": {
                "properties": {
                  "method": {
                    "const": "none"
                  },
                  "confidence": {
                    "const": "none"
                  }
                }
              },
              "else": {
                "properties": {
                  "method": {
                    "enum": [
                      "module-scan",
                      "process-scan"
                    ]
                  },
                  "confidence": {
                    "enum": [
                      "strong",
                      "weak"
                    ]
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "mode": {
                    "const": "single-player"
                  }
                }
              },
              "then": {
                "properties": {
                  "confidence": {
                    "const": "weak"
                  }
                }
              }
            }
          ]
        },
        "job": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "origin",
            "destination",
            "cargoId",
            "cargoName",
            "cargoMass",
            "cargoUnitMass",
            "cargoUnitCount",
            "market",
            "isSpecialJob",
            "cargoLoaded"
          ],
          "properties": {
            "origin": {
              "$ref": "#/$defs/place"
            },
            "destination": {
              "$ref": "#/$defs/place"
            },
            "cargoId": {
              "$ref": "#/$defs/availableId"
            },
            "cargoName": {
              "$ref": "#/$defs/availableLabel"
            },
            "cargoMass": {
              "$ref": "#/$defs/mass"
            },
            "cargoUnitMass": {
              "$ref": "#/$defs/mass"
            },
            "cargoUnitCount": {
              "$ref": "#/$defs/availableCount"
            },
            "market": {
              "$ref": "#/$defs/availableId"
            },
            "isSpecialJob": {
              "$ref": "#/$defs/availableBoolean"
            },
            "cargoLoaded": {
              "$ref": "#/$defs/availableBoolean"
            }
          }
        },
        "trailers": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "complete",
            "items"
          ],
          "properties": {
            "complete": {
              "type": "boolean"
            },
            "items": {
              "type": "array",
              "maxItems": 10,
              "items": {
                "$ref": "#/$defs/trailer"
              }
            }
          }
        },
        "plannedDistance": {
          "$ref": "#/$defs/distance"
        },
        "observedDistance": {
          "$ref": "#/$defs/distance"
        },
        "deliveredDistance": {
          "$ref": "#/$defs/distance"
        },
        "fuelUsed": {
          "$ref": "#/$defs/fuel"
        },
        "cargoDamage": {
          "$ref": "#/$defs/damage"
        },
        "expectedIncome": {
          "$ref": "#/$defs/unsignedMoney"
        },
        "revenue": {
