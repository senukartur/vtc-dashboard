# Local development only. Run the setup script to generate private random passwords.
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3000
WEB_HOST=127.0.0.1
WEB_PORT=5173
API_PROXY_TARGET=http://127.0.0.1:3000
SERVE_WEB=false
WEB_ROOT=apps/web/dist
# Opt in only after explicit migrations/bootstrap; never seeds on startup.
IDENTITY_ENABLED=false
IDENTITY_ORIGIN=http://127.0.0.1:5173
IDENTITY_SECRET=REPLACE_WITH_GENERATED_LOCAL_IDENTITY_SECRET
# VTC-018 provider egress, only after explicit migration and identity activation.
EXTERNAL_IDENTITIES_ENABLED=false
# Separate invitation encryption; requires explicit migrations and identity bootstrap.
ADMISSIONS_ENABLED=false
ADMISSIONS_ENCRYPTION_KEY=REPLACE_WITH_GENERATED_LOCAL_ADMISSIONS_KEY
# Canonical trip reads require migrations and active identity; adapters remain internal.
TRIPS_ENABLED=false
TRIPS_CURSOR_KEY=REPLACE_WITH_SEPARATE_RANDOM_32_BYTE_HEX_KEY
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_DATABASE=vtc_dev
MYSQL_USER=vtc_app
MYSQL_PASSWORD=REPLACE_WITH_GENERATED_LOCAL_PASSWORD
MYSQL_ROOT_PASSWORD=REPLACE_WITH_GENERATED_LOCAL_ROOT_PASSWORD

# Transactional mail stays disabled until explicit activation; values are placeholders.
MAIL_MODE=disabled
MAIL_ENCRYPTION_KEY=REPLACE_WITH_SEPARATE_RANDOM_32_BYTE_HEX_KEY
MAIL_SENDER=sender@example.invalid
MAIL_API_KEY=REPLACE_WITH_PRIVATE_PROVIDER_KEY
MAIL_TRACKING_DISABLED=false

# Personal bearer ingestion requires identity/external identities/trips and explicit migration/grants.
TELEMETRY_ENABLED=false
TELEMETRY_CURSOR_KEY=REPLACE_WITH_SEPARATE_RANDOM_32_BYTE_HEX_KEY
TELEMETRY_IP_PER_MINUTE=600
TELEMETRY_GLOBAL_PER_MINUTE=6000

# Published catalog reads require their own reviewed artifact/provenance configuration.
CATALOGS_ENABLED=false
CATALOGS_SYNTHETIC=false
CATALOGS_CURSOR_KEY=REPLACE_WITH_SEPARATE_RANDOM_32_BYTE_HEX_KEY
CATALOGS_MAX_FILE_BYTES=REPLACE_WITH_REVIEWED_TECHNICAL_BOUND
CATALOGS_ARTIFACT_TTL_MS=REPLACE_WITH_REVIEWED_TECHNICAL_BOUND
CATALOGS_POLICY_REVISION=REPLACE_WITH_POSITIVE_POLICY_REVISION
# Optional private evidence configuration. Disabled until migrations, grants and capacity are verified.
MANUAL_REPORTS_ENABLED=false
MANUAL_REPORTS_KEY=REPLACE_WITH_SEPARATE_RANDOM_32_BYTE_HEX_KEY
MANUAL_MAX_FILES_PER_REPORT=REPLACE_WITH_REVIEWED_TECHNICAL_BOUND
MANUAL_POLICY_REVISION=REPLACE_WITH_POSITIVE_POLICY_REVISION
MANUAL_ORPHAN_GRACE_MS=REPLACE_WITH_REVIEWED_TECHNICAL_GRACE
# Leave empty to disable uploads; Docker's prepared private volume is /app/private-evidence.
MANUAL_EVIDENCE_ROOT=
MANUAL_MAX_FILE_BYTES=REPLACE_WITH_REVIEWED_TECHNICAL_BOUND
MANUAL_MAX_PIXELS=REPLACE_WITH_REVIEWED_TECHNICAL_BOUND
MANUAL_UPLOAD_TIMEOUT_MS=REPLACE_WITH_REVIEWED_TECHNICAL_BOUND
