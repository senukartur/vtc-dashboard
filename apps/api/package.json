{
  "name": "@vtc/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node --env-file-if-exists=../../.env --watch --import tsx src/server.ts",
    "db:check": "node --env-file-if-exists=../../.env --import tsx src/check-db.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/static": "10.1.6",
    "@vtc/contracts": "workspace:*",
    "@vtc/db": "workspace:*",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "fastify": "5.12.7",
    "zod": "4.6.7"
  }
}
