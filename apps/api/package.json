{
  "name": "@vtc/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "db:check": "node --env-file-if-exists=../../.env --import tsx src/check-db.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@better-auth/core": "1.7.10",
    "@better-auth/drizzle-adapter": "1.7.10",
    "@better-auth/utils": "0.5.0",
    "@better-fetch/fetch": "1.3.2",
    "@fastify/multipart": "10.1.4",
    "@fastify/static": "10.1.6",
    "@vtc/contracts": "workspace:*",
    "@vtc/db": "workspace:*",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "better-auth": "1.7.10",
    "better-call": "1.4.2",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.7",
    "jose": "6.2.12",
    "kysely": "0.29.6",
    "nanostores": "1.5.5",
    "zod": "4.6.7"
  }
}
